# ANGEL Platform Configuration

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Teamserver Configuration
TEAMSERVER_ADDR=0.0.0.0
TEAMSERVER_PORT=8080
TEAMSERVER_SECRET=your-secret-key

# Database Configuration
DATABASE_URL=sqlite:///data/angel.db
DATABASE_ENCRYPTION_KEY=your-encryption-key

# C2 Configuration
C2_DEFAULT_PROFILE=teams
C2_DEFAULT_SLEEP=30s
C2_DEFAULT_JITTER=0.25
C2_MAX_AGENTS=1000

# Listener Configuration
LISTENER_HTTPS_PORT=443
LISTENER_DNS_PORT=53
LISTENER_SMB_PORT=445
LISTENER_WEBSOCKET_PORT=8443

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_ROTATION=24h

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/angel/angel.log
LOG_MAX_SIZE=100MB
LOG_MAX_BACKUPS=7

# API Gateway Configuration
API_GATEWAY_ADDR=0.0.0.0
API_GATEWAY_PORT=3000
API_GATEWAY_SECRET=your-gateway-secret

# Frontend Configuration
FRONTEND_URL=http://localhost:4200
FRONTEND_API_URL=http://localhost:8080

# Infrastructure Configuration
INFRA_PROVIDER=aws
INFRA_REGION=us-east-1
INFRA_VPC_CIDR=10.0.0.0/16

# Security Configuration
SECURITY_ENABLE_MFA=true
SECURITY_SESSION_TIMEOUT=30m
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=15m

# Notification Configuration
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_EMAIL_FROM=noreply@example.com

# RPG Configuration (for gamification)
RPG_EXPERIENCE_PER_TASK=100
RPG_LEVEL_UP_THRESHOLD=1000
RPG_ENABLE_ACHIEVEMENTS=true

# Purchase Configuration (for in-app purchases)
PURCHASE_IOS_BUNDLE_ID=com.angel.platform
PURCHASE_STRIPE_KEY=sk_test_your-stripe-key
PURCHASE_WEBHOOK_SECRET=your-webhook-secret
