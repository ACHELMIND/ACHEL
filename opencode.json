{
  "$schema": "https://opencode.ai/config.json",
  "username": "angel-operator",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-sonnet-4-6",
  "default_agent": "build",
  "shell": "/bin/bash",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": true,
  "snapshot": true,

  "instructions": [
    "STRUKTUR_ANGEL.md"
  ],

  "references": {
    "docs": {
      "path": ".",
      "description": "ANGEL platform documentation and architecture"
    }
  },

  "agent": {
    "angel-security": {
      "description": "Security-focused agent for ANGEL offensive platform development",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "angel-reviewer": {
      "description": "Reviews code for security best practices and ANGEL standards",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "go *": "allow",
      "make *": "allow",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  },

  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  },

  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
